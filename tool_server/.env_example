# Server
server_host=127.0.0.1
server_port=8097
server_stateless_http=true

# Logging (e.g. DEBUG, INFO, WARNING, ERROR)
log_level=INFO

# Authentication: clients send "Authorization: Bearer <token>".
# api_tokens is a comma-separated list for the example static verifier; replace it with a real token store.
require_auth=true
api_tokens=
token_cache_seconds=60

# Transport security
enable_dns_rebinding_protection=false
allowed_hosts=127.0.0.1:*,localhost:*,[::1]:*
allowed_origins=http://127.0.0.1:*,http://localhost:*,http://[::1]:*
